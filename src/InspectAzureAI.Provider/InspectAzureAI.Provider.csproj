<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InspectAzureAI.Provider</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public types carry /// summaries; per-member documentation is not required. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Inference" Version="1.0.0-beta.5" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InspectAzureAI.Tests" />
  </ItemGroup>

</Project>
