  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Model/Cost/ModelData/*.json" LogicalName="InspectAzureAI.Eval.ModelData.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
