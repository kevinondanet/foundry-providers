  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InspectAzureAI.Provider\InspectAzureAI.Provider.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InspectAzureAI.Eval.Tests" />
