<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A self-contained teaching app. It deliberately has NO project references:
    every type in it is a miniature stand-in for the real inspect_ai package it
    is named after, so the layering can be read in one sitting. Its single
    package reference is Azure.Identity, used only by the real `azureai`
    provider in Layer6_Providers to turn `az login` into a bearer token.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>demo</RootNamespace>
    <AssemblyName>inspect-layers</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example datasets are real files so that the file-system abstraction
         has a genuine "file://" path to resolve (the log goes to "memory://"). -->
    <None Include="datasets\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
